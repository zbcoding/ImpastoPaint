<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Import Project="../properties/ReferenceGirCoreAdw1.props" />
  <Import Project="../properties/ReferenceGirCorePangoCairo10.props" />

  <ItemGroup>
    <PackageReference Include="NGettext" />
    <PackageReference Include="ParagonClipper" />
    <PackageReference Include="Mono.Addins" />
    <PackageReference Include="System.Formats.Nrbf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pinta.Resources\Pinta.Resources.csproj" />
  </ItemGroup>

  <!--
    The application's own product version constants are generated from Directory.Build.props
    (the AppVersion element), so there is a single place to update the version. This is
    Impasto's own release version, independent of the Pinta add-in ABI compatibility constants
    declared in PintaCore.cs, which only change when rebasing onto a newer upstream Pinta.
  -->
  <Target Name="GenerateAppVersionConstants" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_VersionFile>$(IntermediateOutputPath)PintaCore.Version.g.cs</_VersionFile>
      <_VersionBody>// &lt;auto-generated&gt; Generated from Directory.Build.props - do not edit.%0Anamespace Pinta.Core%3B%0A%0Apublic static partial class PintaCore%0A{%0A%09// Current release version.%0A%09public const string ApplicationVersion = &quot;$(AppVersion)&quot;%3B%0A%0A%09// User-facing version (shown in About and --version).%0A%09public const string DisplayVersion = &quot;$(AppVersion)f&quot;%3B%0A}
      </_VersionBody>
    </PropertyGroup>
    <WriteLinesToFile File="$(_VersionFile)" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="$(_VersionBody)" />
    <ItemGroup>
      <Compile Include="$(_VersionFile)" />
    </ItemGroup>
  </Target>
</Project>
