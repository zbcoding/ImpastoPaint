---
import Layout from '../layouts/Layout.astro';
import { languages, localePath, type Lang } from '../i18n/languages';
import { strings } from '../i18n/strings';
import configureAc from '../../../configure.ac?raw';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings[lang];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const releases = 'https://github.com/zbcoding/ImpastoPaint/releases';
const repo = 'https://github.com/zbcoding/ImpastoPaint';
const pintaUrl = 'https://github.com/PintaProject/Pinta';

// Single source of truth for the release version: configure.ac's AC_INIT, so the site
// never drifts from what `dotnet build`/the release tarball actually ships. `?raw` is
// resolved by Vite against this file's source location, so it survives bundling.
const versionMatch = configureAc.match(/AC_INIT\(\[impasto\],\s*\[([^\]]+)\]\)/);
if (!versionMatch) throw new Error('Could not find Impasto version in configure.ac');
const version = versionMatch[1];

const langEntries = Object.entries(languages) as [Lang, (typeof languages)[Lang]][];
---
<Layout lang={lang} title={`Impasto — ${t.heroH1}`} description={t.metaDescription}>
  <header class="site-header">
    <div class="wrap row">
      <a href={`${base}${localePath(lang)}`} class="brand">
        <img src={`${base}/assets/impasto-logo.svg`} width="32" height="32" alt="" />
        <span>Impasto</span>
      </a>
      <nav class="row nav-row">
        <a href="#screenshots">{t.navScreenshots}</a>
        <a href="#about">{t.navAbout}</a>
        <a href="#platforms">{t.navGet}</a>
        <a href="#docs">{t.navDocs}</a>
        <details class="lang-dd">
          <summary>{languages[lang].name}{lang !== 'en' && <abbr class="ai-badge" title={t.aiTranslatedLabel}>AI</abbr>}</summary>
          <ul>
            {lang === 'en'
              ? <li class="current" aria-current="true">{languages.en.name}</li>
              : <li><a href={`${base}${localePath('en')}`}>{languages.en.name}</a></li>}
            <li class="lang-section-label" role="presentation">
              <abbr class="ai-badge" title={t.aiTranslatedLabel}>AI</abbr>
            </li>
            {langEntries
              .filter(([code]) => code !== 'en')
              .map(([code, info]) => (
                code === lang
                  ? <li class="current" aria-current="true">{info.name}</li>
                  : <li><a href={`${base}${localePath(code)}`}>{info.name}</a></li>
              ))}
          </ul>
        </details>
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="wrap">
      <img src={`${base}/assets/impasto-logo.svg`} width="96" height="96" alt="Impasto application icon, a paint palette with a loaded brush" class="hero-logo" />
      <h1>{t.heroH1}</h1>
      <p class="lede">{t.heroLede}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={`${releases}/tag/v${version}`}>{t.ctaDownload} <span class="version-tag">v{version}</span></a>
        <a class="btn btn-ghost" href={repo}>{t.ctaSource}</a>
      </div>
      <p class="fine">{t.heroFine}</p>
    </div>
  </section>

  <section id="screenshots" class="section">
    <div class="wrap">
      <h2>{t.screenshotsH2}</h2>
      <div class="shots">
        <figure>
          <button type="button" class="shot-btn" data-full={`${base}/assets/screenshot-object-layers.png`}>
            <img src={`${base}/assets/screenshot-object-layers.png`} alt={t.shot1Alt} loading="lazy" />
          </button>
          <figcaption>{t.shot1Caption}</figcaption>
        </figure>
        <figure>
          <button type="button" class="shot-btn" data-full={`${base}/assets/screenshot-text-tool.png`}>
            <img src={`${base}/assets/screenshot-text-tool.png`} alt={t.shot2Alt} loading="lazy" />
          </button>
          <figcaption>{t.shot2Caption}</figcaption>
        </figure>
        <figure>
          <button type="button" class="shot-btn" data-full={`${base}/assets/screenshot-snap-to-grid.png`}>
            <img src={`${base}/assets/screenshot-snap-to-grid.png`} alt={t.shot3Alt} loading="lazy" />
          </button>
          <figcaption>{t.shot3Caption}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <dialog id="lightbox" class="lightbox">
    <button type="button" class="lightbox-close" aria-label={t.closeLightbox}>&times;</button>
    <img id="lightbox-img" src="" alt="" />
  </dialog>

  <section id="about" class="section alt">
    <div class="wrap prose">
      <h2>{t.aboutH2}</h2>
      <p>{t.aboutFeaturesP}</p>
      <p>{t.aboutOriginPre} <a href={pintaUrl}>{t.aboutPintaLink}</a>{t.aboutOriginMid} <strong>{t.aboutPdn}</strong>{t.aboutOriginPost}</p>
    </div>
  </section>

  <section id="platforms" class="section">
    <div class="wrap">
      <h2>{t.platformsH2}</h2>
      <div class="cards">
        <div class="card">
          <h3>
            <svg class="platform-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.287 2.489a.424.424 0 00-.11.135c-.26.268-.45.6-.663.839-.199.199-.485.267-.797.4-.313.136-.658.269-.864.68-.09.189-.136.394-.132.602 0 .199.027.4.055.536.058.399.116.728.04.97-.249.68-.28 1.145-.106 1.484.174.334.535.47.94.601.81.2 1.91.135 2.774.6.926.466 1.866.67 2.616.47.526-.116.97-.464 1.208-.946.587-.003 1.23-.269 2.26-.334.699-.058 1.574.267 2.577.2.025.134.063.198.114.333l.003.003c.391.778 1.113 1.132 1.884 1.071.771-.06 1.592-.536 2.257-1.306.631-.765 1.683-1.084 2.378-1.503.348-.199.629-.469.649-.853.023-.4-.2-.811-.714-1.376v-.097l-.003-.003c-.17-.2-.25-.535-.338-.926-.085-.401-.182-.786-.492-1.046h-.003c-.059-.054-.123-.067-.188-.135a.357.357 0 00-.19-.064c.431-1.278.264-2.55-.173-3.694-.533-1.41-1.465-2.638-2.175-3.483-.796-1.005-1.576-1.957-1.56-3.368.026-2.152.236-6.133-3.544-6.139zm.529 3.405h.013c.213 0 .396.062.584.198.19.135.33.332.438.533.105.259.158.459.166.724 0-.02.006-.04.006-.06v.105a.086.086 0 01-.004-.021l-.004-.024a1.807 1.807 0 01-.15.706.953.953 0 01-.213.335.71.71 0 00-.088-.042c-.104-.045-.198-.064-.284-.133a1.312 1.312 0 00-.22-.066c.05-.06.146-.133.183-.198.053-.128.082-.264.088-.402v-.02a1.21 1.21 0 00-.061-.4c-.045-.134-.101-.2-.183-.333-.084-.066-.167-.132-.267-.132h-.016c-.093 0-.176.03-.262.132a.8.8 0 00-.205.334 1.18 1.18 0 00-.09.4v.019c.002.089.008.179.02.267-.193-.067-.438-.135-.607-.202a1.635 1.635 0 01-.018-.2v-.02a1.772 1.772 0 01.15-.768c.082-.22.232-.406.43-.533a.985.985 0 01.594-.2zm-2.962.059h.036c.142 0 .27.048.399.135.146.129.264.288.344.465.09.199.14.4.153.667v.004c.007.134.006.2-.002.266v.08c-.03.007-.056.018-.083.024-.152.055-.274.135-.393.2.012-.09.013-.18.003-.267v-.015c-.012-.133-.04-.2-.082-.333a.613.613 0 00-.166-.267.248.248 0 00-.183-.064h-.021c-.071.