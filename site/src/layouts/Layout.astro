---
import { languages, localePath, type Lang } from '../i18n/languages';

export interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Localized home pages exist only for the marketing page; docs are English-only. */
  localeAlternates?: boolean;
  /** JSON-LD graph for this page. Defaults to the app-level SoftwareApplication entry. */
  schemas?: Record<string, unknown>[];
  /** Absolute-from-base path of the social card image. */
  ogImage?: string;
}
const {
  lang,
  title,
  description,
  localeAlternates = true,
  schemas,
  ogImage = '/assets/screenshot-object-layers.png',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteOrigin = Astro.site ? Astro.site.origin : '';
const canonical = new URL(Astro.url.pathname, Astro.site);
const langEntries = Object.entries(languages) as [Lang, (typeof languages)[Lang]][];

const softwareApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Impasto',
  applicationCategory: 'GraphicsApplication',
  operatingSystem: 'Linux, Windows, macOS',
  description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  downloadUrl: 'https://github.com/zbcoding/ImpastoPaint/releases',
};
const pageSchemas = schemas ?? [softwareApplicationSchema];
---
<!doctype html>
<html lang={languages[lang].hreflang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/assets/impasto-logo.svg`} />

    {localeAlternates && langEntries.map(([code, info]) => (
      <link rel="alternate" hreflang={info.hreflang} href={`${siteOrigin}${base}${localePath(code)}`} />
    ))}
    {localeAlternates && <link rel="alternate" hreflang="x-default" href={`${siteOrigin}${base}/`} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={languages[lang].og} />
    <meta property="og:image" content={new URL(`${base}${ogImage}`, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {pageSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    ))}

    <!-- ponytail: GoatCounter — free, cookieless, no consent banner needed. Endpoint below is the zbcoding account.
         Page views go straight to GoatCounter's /count endpoint, whose query parameters GoatCounter documents as stable,
         so no third-party JavaScript runs here. This mirrors count.js's page-view path only: click events
         (data-goatcounter-click) and the #toggle-goatcounter opt-out are not implemented. -->
    <script>
      const goatcounterEndpoint = 'https://zbcoding.goatcounter.com/count';
      const localHostname = /(localhost$|^127\.|^10\.|^172\.(1[6-9]|2[0-9]|3[0-1])\.|^192\.168\.|^0\.0\.0\.0$)/;

      // Codes from count.js; GoatCounter's backend treats any value >= 150 as a bot.
      function botCode(): number {
        const w = window as any;
        const d = document as any;
        if (w.callPhantom || w._phantom || w.phantom) return 150;
        if (w.__nightmare) return 151;
        if (d.__selenium_unwrapped || d.__webdriver_evaluate || d.__driver_evaluate) return 152;
        if (navigator.webdriver) return 153;
        return 0;
      }

      function isUncountedVisit(): boolean {
        const isLocal = location.protocol === 'file:' || localHostname.test(location.hostname);
        return isLocal || window !== window.parent;
      }

      function sendPageView() {
        const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]');
        const pageView: Record<string, string> = {
          p: canonical ? new URL(canonical.href).pathname : location.pathname,
          t: document.title,
          r: document.referrer,
          s: [screen.width, screen.height, devicePixelRatio || 1].join(','),
          b: String(botCode()),
          q: location.search,
          rnd: Math.random().toString(36).slice(2, 7),
        };
        const query = new URLSearchParams(Object.entries(pageView).filter(([, value]) => value !== ''));
        const url = `${goatcounterEndpoint}?${query}`;
        if (!navigator.sendBeacon(url)) new Image().src = url;
      }

      // A prerendered or background-opened tab counts once it is first shown.
      function whenVisible(callback: () => void) {
        if (document.visibilityState === 'visible') return callback();
        document.addEventListener('visibilitychange', function onChange() {
          if (document.visibilityState !== 'visible') return;
          document.removeEventListener('visibilitychange', onChange);
          callback();
        });
      }

      if (isUncountedVisit()) console.info('goatcounter: not counting a local or framed visit');
      else whenVisible(sendPageView);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #14151a;
    --bg-raised: #1c1e26;
    --fg: #eef0f5;
    --fg-muted: #a6acbf;
    --accent: #e2843f;
    --accent-2: #7fb3ff;
    --border: #2b2e3a;
    font-family: -apple-system, "Segoe UI", Roboto, Ubuntu, sans-serif;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    line-height: 1.55;
  }

  a { color: var(--accent-2); }

  img { max-width: 100%; display: block; }

  code {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1em 0.4em;
    font-size: 0.9em;
  }
</style>
