---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
const releases = 'https://github.com/zbcoding/ImpastoPaint/releases';
const repo = 'https://github.com/zbcoding/ImpastoPaint';

const description =
  "Impasto is a free, open-source paint program for Linux, Windows, and macOS. " +
  "Layers, editable text and shapes, and snapping-aware selection tools. " +
  "Download the Linux paint app, or grab the Flatpak-ready build.";
---
<Layout title="Impasto — a free paint app for Linux, Windows, and macOS" description={description}>
  <header class="site-header">
    <div class="wrap row">
      <a href={`${base}/`} class="brand">
        <img src={`${base}/assets/impasto-logo.svg`} width="32" height="32" alt="" />
        <span>Impasto</span>
      </a>
      <nav>
        <a href="#screenshots">Screenshots</a>
        <a href="#about">About</a>
        <a href="#platforms">Get it</a>
        <a href="#docs" aria-disabled="true">Docs</a>
        <a href={repo}>GitHub</a>
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="wrap">
      <img src={`${base}/assets/impasto-logo.svg`} width="96" height="96" alt="Impasto application icon, a paint palette with a loaded brush" class="hero-logo" />
      <h1>A free paint app for Linux, Windows, and macOS</h1>
      <p class="lede">
        Impasto is an open-source raster painting and image editor: layers, undo history,
        editable text and shapes, and grid/edge snapping while you draw. No account,
        no subscription, no telemetry.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={releases}>Download from GitHub Releases</a>
        <a class="btn btn-ghost" href={repo}>View source on GitHub</a>
      </div>
      <p class="fine">Native builds for Linux, Windows, and macOS &middot; MIT licensed</p>
    </div>
  </section>

  <section id="screenshots" class="section">
    <div class="wrap">
      <h2>See it in action</h2>
      <div class="shots">
        <figure>
          <img src={`${base}/assets/screenshot-object-layers.png`} alt="Impasto with shapes and text kept as editable objects, each with its own undo history" loading="lazy" />
          <figcaption>Shapes and text stay editable objects, with per-object history.</figcaption>
        </figure>
        <figure>
          <img src={`${base}/assets/screenshot-text-tool.png`} alt="Impasto text tool with the UI preferences dialog open" loading="lazy" />
          <figcaption>The text tool, with the UI preferences dialog open.</figcaption>
        </figure>
        <figure>
          <img src={`${base}/assets/screenshot-snap-to-grid.png`} alt="Impasto showing a shape control point snapping to a drawn guide on the canvas" loading="lazy" />
          <figcaption>Drawing snaps to the grid, ruler units, canvas edges, and centre lines.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="about" class="section alt">
    <div class="wrap prose">
      <h2>Where Impasto comes from</h2>
      <p>
        Impasto is a fork of <a href="https://github.com/PintaProject/Pinta">Pinta</a>, the
        MIT-licensed, GTK-based painting app — which was itself inspired by a well-known
        Windows paint program from the mid-2000s, often shortened to <strong>PDN</strong>.
        Impasto keeps that lineage in its bones (layers, tool options, the overall workflow)
        while growing its own feature set: an object-based canvas where shapes and text
        remain editable after you draw them, snapping-aware selection tools, and a keyboard
        shortcut system you can fully remap.
      </p>
      <p>
        It's a separate project with its own contributors, not maintained by Pinta or by
        the authors of the program that inspired Pinta.
      </p>
    </div>
  </section>

  <section id="platforms" class="section">
    <div class="wrap">
      <h2>Get Impasto</h2>
      <div class="cards">
        <div class="card">
          <h3>Linux</h3>
          <p>
            Prebuilt Linux binaries are on the releases page. A Flatpak manifest ships in
            the repo for building your own sandboxed <code>.flatpak</code> bundle; a
            Flathub listing is on the roadmap but not live yet.
          </p>
          <a class="btn btn-small" href={releases}>Linux download</a>
        </div>
        <div class="card">
          <h3>Windows</h3>
          <p>A native Windows build is published with every release.</p>
          <a class="btn btn-small" href={releases}>Windows download</a>
        </div>
        <div class="card">
          <h3>macOS</h3>
          <p>A native macOS build is published with every release.</p>
          <a class="btn btn-small" href={releases}>macOS download</a>
        </div>
      </div>
    </div>
  </section>

  <section id="docs" class="section alt">
    <div class="wrap prose">
      <h2>Documentation</h2>
      <p>User docs for Impasto are coming to this site soon. Until then, the
        <a href={`${repo}#readme`}>README</a> and the
        <a href={`${repo}/tree/main/docs`}>docs folder</a> on GitHub cover the current
        feature set, file formats, and add-ins.</p>
    </div>
  </section>

  <footer class="site-footer">
    <div class="wrap row">
      <p>Impasto is free and open source, licensed under the MIT License.</p>
      <nav>
        <a href={repo}>GitHub</a>
        <a href={releases}>Releases</a>
        <a href={`${repo}/issues`}>Issues</a>
      </nav>
    </div>
  </footer>
</Layout>

<style>
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 1.5rem; }
  .row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }

  .site-header { border-bottom: 1px solid var(--border); padding: 1rem 0; position: sticky; top: 0; background: rgba(20, 21, 26, 0.9); backdrop-filter: blur(6px); z-index: 10; }
  .brand { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 1.15rem; color: var(--fg); text-decoration: none; }
  .site-header nav { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .site-header nav a { color: var(--fg-muted); text-decoration: none; font-size: 0.95rem; }
  .site-header nav a:hover { color: var(--fg); }

  .hero { text-align: center; padding: 4.5rem 0 3.5rem; }
  .hero-logo { margin: 0 auto 1.5rem; }
  .hero h1 { font-size: clamp(1.9rem, 4vw, 2.75rem); margin: 0 0 1rem; }
  .lede { max-width: 640px; margin: 0 auto 2rem; color: var(--fg-muted); font-size: 1.1rem; }
  .cta-row { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .fine { margin-top: 1.25rem; color: var(--fg-muted); font-size: 0.9rem; }

  .btn { display: inline-block; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; font-weight: 600; border: 1px solid transparent; }
  .btn-primary { background: var(--accent); color: #1a1305; }
  .btn-ghost { border-color: var(--border); color: var(--fg); }
  .btn-small { padding: 0.45rem 1rem; font-size: 0.9rem; border: 1px solid var(--border); color: var(--fg); border-radius: 6px; }

  .section { padding: 3.5rem 0; }
  .section.alt { background: var(--bg-raised); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .section h2 { font-size: 1.6rem; margin-bottom: 1.5rem; }
  .prose { max-width: 720px; }
  .prose p { color: var(--fg-muted); }

  .shots { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; }
  .shots figure { margin: 0; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: var(--bg-raised); }
  .shots img { width: 100%; }
  .shots figcaption { padding: 0.75rem 1rem; color: var(--fg-muted); font-size: 0.9rem; }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; }
  .card { border: 1px solid var(--border); border-radius: 10px; padding: 1.5rem; background: var(--bg-raised); }
  .card h3 { margin-top: 0; }
  .card p { color: var(--fg-muted); min-height: 4.5em; }

  .site-footer { padding: 2rem 0 3rem; color: var(--fg-muted); font-size: 0.9rem; }
  .site-footer nav { display: flex; gap: 1.25rem; }
  .site-footer a { color: var(--fg-muted); }
</style>
