<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>com.github.zbcoding.Impasto</id>
  <!-- No <replaces>: Impasto installs alongside Pinta, it does not supersede it. -->
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Impasto</name>
  <summary>Paint and edit images</summary>
  <description>
    <_p>
      Impasto is a paint and image editing application with a wide range of
      drawing tools, including freehand, rectangles, circles and lines.
      It has over 35 effects to apply to your images, and unlimited layers
      to help organize your creativity.
    </_p>
    <_p>
      Impasto is a fork of Pinta.
    </_p>
  </description>
  <launchable type="desktop-id">com.github.zbcoding.Impasto.desktop</launchable>
  <kudos>
    <kudo>HiDpiIcon</kudo>
  </kudos>
  <screenshots>
    <screenshot type="default">
      <caption>Shapes and text as editable objects, with per-object history</caption>
      <image>https://raw.githubusercontent.com/zbcoding/ImpastoPaint/main/docs/screenshots/impasto-object-layers.png</image>
    </screenshot>
    <screenshot>
      <caption>The text tool, with the UI preferences dialog open</caption>
      <image>https://raw.githubusercontent.com/zbcoding/ImpastoPaint/main/docs/screenshots/impasto-text-tool.png</image>
    </screenshot>
  </screenshots>
  <developer id="com.github.zbcoding">
    <name>zbcoding</name>
  </developer>
  <url type="homepage">https://github.com/zbcoding/ImpastoPaint</url>
  <url type="vcs-browser">https://github.com/zbcoding/ImpastoPaint</url>
  <url type="bugtracker">https://github.com/zbcoding/ImpastoPaint/issues</url>
  <content_rating type="oars-1.0" />
  <translation type="gettext">impasto</translation>
  <provides>
    <binary>impasto</binary>
  </provides>
  <releases>
    <release version="0.2.0" date="2026-09-02">
      <url>https://github.com/zbcoding/ImpastoPaint/releases/tag/v0.2.0</url>
      <description>
        <p>The Line/Curve tool gains a Type dropdown for how new points join their neighbours, a Close shape toggle so fill modes work on a line or curve, and S/D shortcuts to snap a control point's tension. The layers dock now highlights the object being edited on the canvas. Linux releases add a single-file AppImage. This release also fixes a long list of tool-switch crashes, leaks and selection bugs in the shape, text, move and gradient tools.</p>
      </description>
    </release>
    <release version="0.1.1" date="2026-08-28">
      <url>https://github.com/zbcoding/ImpastoPaint/releases/tag/v0.1.1</url>
      <description>
        <p>Fixes saving under a file name with no extension. The file is no longer written to a different path than the one chosen, and a dotfile-style name now gets the selected format's extension.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-08-27">
      <url>https://github.com/zbcoding/ImpastoPaint/releases/tag/v0.1.0</url>
      <description>
        <p>Shapes and text are now editable objects with their own layer rows and per-object history, and layer effects are non-destructive and saved in .ora files. This release also adds autosave, a floating Colors window with an eyedropper and CSS color input, per-layer solo visibility, and a range of fixes.</p>
      </description>
    </release>
    <release version="0.0.1" date="2026-08-09">
      <url>https://github.com/zbcoding/ImpastoPaint/releases/tag/v0.0.1</url>
      <description>
        <p>First Impasto release, forked from Pinta 3.1.2.</p>
      </description>
    </release>
    <!-- Pinta 3.1.2 and earlier: see CHANGELOG.md. Software centres show only
         Impasto releases here; appstream requires this list be version-ordered. -->
  </releases>
</component>
